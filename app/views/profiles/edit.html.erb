<h1>プロフィール編集</h1>

<%= form_with model: @user, url: user_profile_path(@user), method: :patch do |f| %>
  <p>
    <%= f.label :age, "年齢" %>
    <%= f.number_field :age, min: 0 %>
  </p>

  <p>
    <%= f.label :bio, "自己紹介" %>
    <%= f.text_area :bio, rows: 5 %>
  </p>

  <%= f.submit "保存する" %>
<% end %>

<%= link_to "プロフィールへ戻る", user_profile_path(@user) %>
